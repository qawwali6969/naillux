# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Admin Bot Token (separate bot for admin panel)
ADMIN_BOT_TOKEN=your_admin_bot_token_here

# Admin User IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Notification Group ID (optional - for admin notifications)
NOTIFICATION_GROUP_ID=-1001234567890

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Web Admin Panel Configuration
WEB_ADMIN_SECRET_KEY=change-this-random-secret-key-in-production
ADMIN_PASSWORD=your_secure_admin_password_here
